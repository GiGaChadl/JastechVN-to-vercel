# Database
DATABASE_URL=postgresql://jastech:jastech@localhost:5432/jastech

# Authentication
AUTH_SECRET=replace-with-local-development-secret

# Recatpcha V3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_google_app_password

# Application
APP_URL=http://localhost:3000

# Media Storage (local driver)
MEDIA_DRIVER=local
MEDIA_LOCAL_DIRECTORY=.runtime/uploads

# Email (log driver for local development)
EMAIL_DRIVER=log

# Admin seed: use a non-placeholder password of at least 12 characters.
# Re-running seed preserves an existing admin password; no login backend exists yet.
ADMIN_EMAIL=admin@jastech.local
ADMIN_PASSWORD=change-this-password
